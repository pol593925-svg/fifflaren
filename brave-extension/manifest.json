{
  "manifest_version": 3,
  "name": "Support Hub — Коллы и биржи",
  "version": "1.2.0",
  "description": "Меню расширения открывает справочник бирж в Support Hub. На рабочей странице доступна кнопка колла.",
  "action": {
    "default_title": "Support Hub — Биржи",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://admin.standard-margin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
