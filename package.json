{
  "name": "support-hub-desktop",
  "version": "4.0.1",
  "description": "Support Hub Tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win",
    "test:graphics": "node tools/validate-graphics.cjs",
    "test:ui": "node tools/ui-smoke.cjs",
    "test:graphics:browser": "node tools/graphics-smoke.cjs"
  },
  "build": {
    "appId": "com.supporthub.app",
    "protocols": [{"name":"Support Hub", "schemes":["supporthub"]}],
    "extraResources": [{"from":"brave-extension", "to":"brave-extension", "filter":["manifest.json","content.js"]}],
    "productName": "Support Hub",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "publish": {
      "provider": "github",
      "owner": "pol593925-svg",
      "repo": "fifflaren"
    },
    "artifactName": "Support-Hub-Setup-${version}.${ext}",
    "files": [
      "**/*",
      "!tools/**",
      "!brave-extension/**",
      "!models/csgo/textures/**",
      "!graphics-qa/**",
      "!support2*.js",
      "!models/s2/**",
      "!assets/support2/**"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.1"
  }
}
