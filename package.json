    },
    "publish": {
      "provider": "github",
      "owner": "pol593925-svg",
      "repo": "fifflaren"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}